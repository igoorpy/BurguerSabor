{
  "name": "burguer-sabor-api",
  "version": "1.0.0",
  "description": "Backend do Burguer & Sabor — projeto de apresentação (NestJS + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "db:reset": "node scripts/reset-db.js",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "diagnostics": false }]
    },
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": ["<rootDir>/test/setup-env.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/main.ts"],
    "testTimeout": 20000
  }
}
