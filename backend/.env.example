# Porta HTTP da API
PORT=3000

# Conexão com o PostgreSQL (banco principal)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/burguer_sabor

# Banco separado usado pelos testes automatizados (é apagado e recriado a cada execução)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/burguer_sabor_test

# Tamanho máximo do pool de conexões
DB_POOL_MAX=10

# Segredo para assinar os tokens de login. O Iniciar BurguerSabor.bat gera um aleatório na primeira vez.
JWT_SECRET=troque-este-segredo
# Validade do token em segundos (28800 = 8 horas)
JWT_EXPIRES_IN_SECONDS=28800

# Taxa de entrega cobrada em cada pedido (R$)
TAXA_ENTREGA=5.00

# Tempo de entrega mostrado no site (minutos)
TEMPO_ENTREGA_MIN=30
TEMPO_ENTREGA_MAX=45
